#!/bin/sh
#
# Release environment, sourced by bin/ex_monty_cad_server before the node boots.
#
# The release needs a node name only when it is one node of several — a cluster of
# plugins is the reason this server has distribution at all. A deployment on one
# machine needs nothing here: without a name the node is a cluster of one, which
# is what most installs are.
#
# Distribution carries no secrets: a plugin is a process offered by a node that
# already trusts this one, so the cookie is the operator's own.

if [ -n "${NODE_NAME:-}" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${NODE_NAME}"
fi

# Where the catalogue lives when no database server is named. A container mounts a
# volume here, so the file survives the container; without a volume it is the
# container's own filesystem, which is discarded with it.
if [ -z "${DATABASE_URL:-}" ] && [ -z "${SQLITE_PATH:-}" ]; then
  export SQLITE_PATH="${DATA_DIR:-/app/data}/catalogue.db"
fi
